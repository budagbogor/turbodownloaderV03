{
  "manifest_version": 3,
  "name": "TurboDownloader Integration Module",
  "version": "1.0.0",
  "description": "Modul integrasi otomatis browser IDM-class untuk TurboDownloader. Deteksi video dan tampilkan tombol unduh di semua situs.",
  "permissions": [
    "webRequest",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TurboDownloader Media Sniffer"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
